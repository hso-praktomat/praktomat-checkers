#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(dirname "$0")/.."
cd "$REPO_ROOT"

# Under Linux (CI, devcontainer, docker) we use .venv_linux, so that it does not clash with
# the .venv of a macOS host sharing the same checkout.
if [ "$(uname -s)" == "Linux" ]; then
    VENV=.venv_linux
else
    VENV=.venv
fi

if [ ! -x "$VENV/bin/pyright" ]; then
    echo "$VENV/bin/pyright not found. Create the venv with Python 3.12 and run" >&2
    echo "  $VENV/bin/pip install -r requirements.txt" >&2
    exit 1
fi

echo "Running pyright from $VENV ..."
"$VENV/bin/pyright" --pythonpath "$VENV/bin/python"
