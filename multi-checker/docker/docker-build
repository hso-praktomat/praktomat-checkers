#!/bin/bash

if [ "$1" == "--help" ]; then
    echo "USAGE: $0 [--build-base] [--no-push] [PLATFORM]"
    echo "Platform is either linux/arm64 or linux/amd64 (default)"
    exit 1
fi

build_base=0
no_push=""
while [ "$1" == "--build-base" ] || [ "$1" == "--no-push" ]; do
    if [ "$1" == "--build-base" ]; then
        build_base=1
    else
        no_push="--no-push"
    fi
    shift
done

if [ -z "$1"  ]; then
    platform="linux/amd64"
else
    platform="$1"
fi

if [ $build_base == 1 ]; then
    echo "Building docker base image ..."
    $(dirname $0)/../../checker-container/docker-build $no_push "$platform" || exit 1
    echo "Done building docker base image"
fi

TAG=skogsbaer/praktomat-multi-checker:latest

cd $(dirname $0)
trap "rm -rf checker" EXIT
cp -r ../script/ checker
docker build --platform "$platform" --tag $TAG . || exit 1
echo
echo "Successfully build image with tag $TAG."

if [ -n "$no_push" ]; then
    echo "Not pushing because of --no-push"
elif [ $(hostname) == "progcheck" ]; then
    echo "Not pushing because we are running on progcheck"
elif [ "$platform" == "linux/arm64" ]; then
    echo "Not pushing image for ARM64"
else
    docker push $TAG
    echo "Successfully pushed image with tag $TAG"
fi
